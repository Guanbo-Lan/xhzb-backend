<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xhzb.nursing.mapper.NursingProjectPlanMapper">

	<resultMap type="NursingProjectPlan" id="NursingProjectPlanResult">
		<id     property="id"                column="id"                />
		<result property="planId"            column="plan_id"           />
		<result property="projectId"         column="project_id"        />
		<result property="executeCycle"      column="execute_cycle"     />
		<result property="executeFrequency"  column="execute_frequency" />
		<result property="executeTime"       column="execute_time"      />
		<result property="createBy"          column="create_by"         />
		<result property="createTime"        column="create_time"       />
		<result property="updateBy"          column="update_by"         />
		<result property="updateTime"        column="update_time"       />
		<result property="remark"            column="remark"            />
	</resultMap>

	<sql id="selectNursingProjectPlanVo">
        select id, plan_id, project_id, execute_cycle, execute_frequency, execute_time, create_by, create_time, update_by, update_time, remark
		from nursing_project_plan
    </sql>

	<select id="selectByPlanId" parameterType="Long" resultMap="NursingProjectPlanResult">
		<include refid="selectNursingProjectPlanVo"/>
		where plan_id = #{planId}
		order by id
	</select>

	<insert id="insertBatch" parameterType="java.util.List">
		insert into nursing_project_plan(
			plan_id, project_id, execute_cycle, execute_frequency, execute_time, remark, create_by, create_time
		)values
		<foreach collection="list" item="item" separator=",">
			(
				#{item.planId}, #{item.projectId}, #{item.executeCycle}, #{item.executeFrequency},
				#{item.executeTime}, #{item.remark}, #{item.createBy}, sysdate()
			)
		</foreach>
	</insert>

	<select id="countByProjectId" parameterType="Long" resultType="int">
		select count(1) from nursing_project_plan where project_id = #{projectId}
	</select>

	<delete id="deleteByPlanId" parameterType="Long">
		delete from nursing_project_plan where plan_id = #{planId}
	</delete>

</mapper>
