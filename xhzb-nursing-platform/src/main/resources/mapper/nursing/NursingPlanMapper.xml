<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xhzb.nursing.mapper.NursingPlanMapper">

	<resultMap type="NursingPlan" id="NursingPlanResult">
		<id     property="id"         column="id"         />
		<result property="planName"   column="plan_name"  />
		<result property="sortNo"     column="sort_no"    />
		<result property="status"     column="status"     />
		<result property="createBy"   column="create_by"  />
		<result property="createTime" column="create_time"/>
		<result property="updateBy"   column="update_by"  />
		<result property="updateTime" column="update_time"/>
		<result property="remark"     column="remark"     />
	</resultMap>

	<!-- 详情用：额外带出护理项目明细 -->
	<resultMap type="NursingPlan" id="NursingPlanNursingProjectPlanResult" extends="NursingPlanResult">
		<collection property="projectPlans" column="id" ofType="NursingProjectPlan"
			select="com.xhzb.nursing.mapper.NursingProjectPlanMapper.selectByPlanId" />
	</resultMap>

	<sql id="selectNursingPlanVo">
        select id, plan_name, sort_no, status, create_by, create_time, update_by, update_time, remark
		from nursing_plan
    </sql>

	<select id="selectNursingPlanList" parameterType="NursingPlan" resultMap="NursingPlanResult">
	    <include refid="selectNursingPlanVo"/>
		<where>
			<if test="name != null and name != ''">
				AND plan_name like concat('%', #{name}, '%')
			</if>
			<if test="status != null">
				AND status = #{status}
			</if>
		</where>
		order by ifnull(sort_no, 9999), id
	</select>

	<select id="selectNursingPlanAll" resultMap="NursingPlanResult">
		<include refid="selectNursingPlanVo"/>
		order by ifnull(sort_no, 9999), id
	</select>

	<select id="selectNursingPlanById" parameterType="Long" resultMap="NursingPlanNursingProjectPlanResult">
		<include refid="selectNursingPlanVo"/>
		where id = #{id}
	</select>

	<select id="checkNameUnique" parameterType="String" resultMap="NursingPlanResult">
		<include refid="selectNursingPlanVo"/>
		 where plan_name = #{planName} limit 1
	</select>

	<insert id="insertNursingPlan" parameterType="NursingPlan" useGeneratedKeys="true" keyProperty="id">
 		insert into nursing_plan(
 			<if test="planName != null and planName != ''">plan_name,</if>
 			<if test="sortNo != null">sort_no,</if>
 			<if test="status != null">status,</if>
 			<if test="remark != null and remark != ''">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			create_time
 		)values(
 			<if test="planName != null and planName != ''">#{planName},</if>
 			<if test="sortNo != null">#{sortNo},</if>
 			<if test="status != null">#{status},</if>
 			<if test="remark != null and remark != ''">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			sysdate()
 		)
	</insert>

	<update id="updateNursingPlan" parameterType="NursingPlan">
 		update nursing_plan
 		<set>
 			<if test="planName != null and planName != ''">plan_name = #{planName},</if>
 			<if test="sortNo != null">sort_no = #{sortNo},</if>
 			<if test="status != null">status = #{status},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		</set>
 		where id = #{id}
	</update>

	<update id="updateNursingPlanStatus" parameterType="NursingPlan">
 		update nursing_plan
 		set status = #{status},
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		where id = #{id}
	</update>

	<delete id="deleteNursingPlanByIds" parameterType="Long">
		delete from nursing_plan where id in
		<foreach collection="array" item="id" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>

</mapper>
