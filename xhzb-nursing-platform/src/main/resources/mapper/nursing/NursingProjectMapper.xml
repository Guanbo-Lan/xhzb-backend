<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xhzb.nursing.mapper.NursingProjectMapper">

	<resultMap type="NursingProject" id="NursingProjectResult">
		<id     property="id"                  column="id"                  />
		<result property="name"                column="name"                />
		<result property="orderNo"             column="order_no"            />
		<result property="unit"                column="unit"                />
		<result property="price"               column="price"               />
		<result property="image"               column="image"               />
		<result property="nursingRequirement"  column="nursing_requirement" />
		<result property="status"              column="status"              />
		<result property="createBy"            column="create_by"           />
		<result property="createTime"          column="create_time"         />
		<result property="updateBy"            column="update_by"           />
		<result property="updateTime"          column="update_time"         />
		<result property="remark"              column="remark"              />
	</resultMap>

	<sql id="selectNursingProjectVo">
        select id, name, order_no, unit, price, image, nursing_requirement, status, create_by, create_time, update_by, update_time, remark
		from nursing_project
    </sql>

	<select id="selectNursingProjectList" parameterType="NursingProject" resultMap="NursingProjectResult">
	    <include refid="selectNursingProjectVo"/>
		<where>
			<if test="name != null and name != ''">
				AND name like concat('%', #{name}, '%')
			</if>
			<if test="status != null">
				AND status = #{status}
			</if>
		</where>
		order by ifnull(order_no, 9999), id
	</select>

	<select id="selectNursingProjectAll" resultType="SelectOptionVo">
		select id as `value`, name as label
		from nursing_project
		order by ifnull(order_no, 9999), id
	</select>

	<select id="selectNursingProjectById" parameterType="Long" resultMap="NursingProjectResult">
		<include refid="selectNursingProjectVo"/>
		where id = #{id}
	</select>

	<select id="checkNameUnique" parameterType="String" resultMap="NursingProjectResult">
		<include refid="selectNursingProjectVo"/>
		 where name = #{name} limit 1
	</select>

	<insert id="insertNursingProject" parameterType="NursingProject" useGeneratedKeys="true" keyProperty="id">
 		insert into nursing_project(
 			<if test="name != null and name != ''">name,</if>
 			<if test="orderNo != null">order_no,</if>
 			<if test="unit != null and unit != ''">unit,</if>
 			<if test="price != null">price,</if>
 			<if test="image != null and image != ''">image,</if>
 			<if test="nursingRequirement != null and nursingRequirement != ''">nursing_requirement,</if>
 			<if test="status != null">status,</if>
 			<if test="remark != null and remark != ''">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			create_time
 		)values(
 			<if test="name != null and name != ''">#{name},</if>
 			<if test="orderNo != null">#{orderNo},</if>
 			<if test="unit != null and unit != ''">#{unit},</if>
 			<if test="price != null">#{price},</if>
 			<if test="image != null and image != ''">#{image},</if>
 			<if test="nursingRequirement != null and nursingRequirement != ''">#{nursingRequirement},</if>
 			<if test="status != null">#{status},</if>
 			<if test="remark != null and remark != ''">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			sysdate()
 		)
	</insert>

	<update id="updateNursingProject" parameterType="NursingProject">
 		update nursing_project
 		<set>
 			<if test="name != null and name != ''">name = #{name},</if>
 			<if test="orderNo != null">order_no = #{orderNo},</if>
 			<if test="unit != null and unit != ''">unit = #{unit},</if>
 			<if test="price != null">price = #{price},</if>
 			<if test="image != null">image = #{image},</if>
 			<if test="nursingRequirement != null">nursing_requirement = #{nursingRequirement},</if>
 			<if test="status != null">status = #{status},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		</set>
 		where id = #{id}
	</update>

	<update id="updateNursingProjectStatus" parameterType="NursingProject">
 		update nursing_project
 		set status = #{status},
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		where id = #{id}
	</update>

	<delete id="deleteNursingProjectByIds" parameterType="Long">
		delete from nursing_project where id in
		<foreach collection="array" item="id" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>

</mapper>
